{
  "name": "java-to-angular-setting-class",
  "displayName": "java-to-angular-setting-class",
  "description": "Transforma campos Java con JPA en propiedades TypeScript con decoradores para fwk Setting.",
  "version": "1.1.0",
  "publisher": "Moncho",
  "icon": "icon.png",
  "license": "CC-BY-ND-4.0",
  "engines": {
    "vscode": "^1.101.0"
  },
  "resources": {
    "license": {
      "type": "CC-BY-ND-4.0",
      "url": "https://creativecommons.org/licenses/by-nd/4.0/"
    },
    "repository": {
      "url": "https://github.com/MonchoGrande/java-to-angular-setting-class"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MonchoGrande/java-to-angular-setting-class.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:jata-to-angular-setting-class.convert"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jata-to-angular-setting-class.convert",
        "title": "Convert Java Entity to Angular Setting Class"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "jata-to-angular-setting-class.convert",
          "when": "resourceLangId == java",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "jata-to-angular-setting-class.convert",
          "when": "editorLangId == java",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}